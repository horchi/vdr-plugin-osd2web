#
# Makefile
#
# See the README file for copyright information and how to reach the author.
#

include ../Make.config

LIBTARGET = libhorchi
HLIB      = -L. -lhorchi

DEMO = demo
TEST = tst

LIBOBJS = common.o config.o json.o xml.o

ifdef USEEPGD
   LIBOBJS += epgservice.o
endif

ifdef USEJPEG
   LIBOBJS += imgtools.o
endif

ifdef USECURL
   LIBOBJS += curl.o configuration.o thread.o
endif

BASELIBS = -lrt -lz
BASELIBS += $(shell pkg-config --libs uuid)
BASELIBS += $(shell pkg-config --libs tinyxml2)

ifdef USEDB
   BASELIBS += $(shell mysql_config --libs_r)
   LIBOBJS += db.o dbdict.o
	USES += -DUSEDB
endif

ifdef USECURL
   BASELIBS += -lcurl
endif

ifdef USEEPGS
	LIBOBJS += searchtimer.o
endif

ifdef USEPYTHON
	BASELIBS += $(shell python-config --libs)
   LIBOBJS += python.o
endif

ifdef USELIBXML
   BASELIBS += $(shell xml2-config --libs) $(shell xslt-config --libs)
endif

ifdef SYSD_NOTIFY
   BASELIBS  += $(shell pkg-config --libs libsystemd-daemon)
	CFLAGS += $(shell pkg-config --cflags libsystemd-daemon)
endif

ifdef DEBUG
   CFLAGS += -ggdb -O0
endif

ifdef USEDB
   CFLAGS += $(shell mysql_config --include)
endif

DEFINES += $(USES)

ifdef USEPYTHON
	CFLAGS += $(shell python-config --includes)
endif

all: lib
lib: $(LIBTARGET).a

$(LIBTARGET).a : $(LIBOBJS)
	@echo Building Lib ...
	$(doLib) $@ $(LIBOBJS)

tst: test.o lib
	$(doLink) test.o $(HLIB) -larchive -lcrypto $(BASELIBS) -o $@

demo: demo.o lib
	$(doLink) demo.o $(HLIB) -larchive -lcrypto $(BASELIBS) -o $@

pytst: pytst.c python.c python.h hlib
	$(CC) $(CFLAGS) pytst.c python.c -L./lib -lhorchi $(DLIBS) -o pytst

clean:
	rm -f *.o *.d *~ core $(TEST) $(DEMO) $(LIBTARGET).a

cppchk:
	cppcheck --language=c++ --template="{file}:{line}:{severity}:{message}" --quiet --force *.c *.h

%.o: %.c
	@echo Compile "$(*F)" ...
	$(doCompile) -MD -MP $(*F).c -o $@

#--------------------------------------------------------
# dependencies
#--------------------------------------------------------
#
# Generated by the compiler (-MD), covering system headers
# like tinyxml2.h as well. Don't maintain them by hand.

DEPS = $(LIBOBJS:.o=.d) test.d demo.d

-include $(DEPS)
